{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:ev-station",
        "state": {
          "charging": "mdi:battery-charging",
          "faulted": "mdi:alert-circle",
          "suspended_ev": "mdi:pause-circle",
          "suspended_evse": "mdi:pause-circle",
          "suspended_no_power": "mdi:pause-circle",
          "unreachable": "mdi:lan-disconnect",
          "connected": "mdi:ev-plug-type2",
          "preparing": "mdi:ev-plug-type2"
        }
      },
      "power": { "default": "mdi:flash" },
      "session_energy": { "default": "mdi:battery-plus" },
      "lifetime_energy": { "default": "mdi:counter" },
      "session_duration": { "default": "mdi:timer-outline" },
      "max_available_power": { "default": "mdi:gauge-full" },
      "power_limit": { "default": "mdi:gauge" },
      "external_power": { "default": "mdi:home-lightning-bolt" },
      "error": { "default": "mdi:alert-outline", "state": { "none": "mdi:check-circle-outline" } },
      "active_schedules": { "default": "mdi:calendar-clock" },
      "last_charge_energy": { "default": "mdi:history" },
      "last_charge_cost": { "default": "mdi:cash" },
      "last_charge_saving": { "default": "mdi:piggy-bank" },
      "charge_card": { "default": "mdi:card-account-details" }
    },
    "binary_sensor": {
      "schedule_active": { "default": "mdi:calendar-clock", "state": { "off": "mdi:calendar-remove" } }
    },
    "button": {
      "start": { "default": "mdi:play" },
      "pause": { "default": "mdi:pause" },
      "resume": { "default": "mdi:play-pause" },
      "stop": { "default": "mdi:stop" }
    },
    "number": {
      "max_current": { "default": "mdi:current-ac" }
    },
    "select": {
      "behaviour_mode": { "default": "mdi:account-key", "state": { "free": "mdi:lock-open-variant" } }
    }
  }
}
