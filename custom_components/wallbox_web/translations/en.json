{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Wallbox WEB server",
        "description": "Address of your Wallbox WEB server and an API token. Create the token in the app as administrator: Menu › API tokens › + (permissions: Read and commands).",
        "data": {
          "url": "URL",
          "token": "API token",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "url": "For example https://wallbox.example.com, without a trailing slash.",
          "token": "Starts with wbx_. It is shown only once when created.",
          "verify_ssl": "Turn off only for a self-signed certificate on your LAN."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Wallbox WEB",
        "description": "The API token for {url} is no longer valid. Create a new one in the app (Menu › API tokens) and paste it here.",
        "data": {
          "token": "API token"
        },
        "data_description": {
          "token": "Starts with wbx_."
        }
      },
      "reconfigure": {
        "title": "Change Wallbox WEB server",
        "data": {
          "url": "URL",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "url": "New address of the same server.",
          "verify_ssl": "Turn off only for a self-signed certificate on your LAN."
        }
      },
      "hassio_confirm": {
        "title": "Wallbox WEB add-on",
        "description": "Do you want to configure Home Assistant to connect to the Wallbox WEB server provided by the add-on {addon}?"
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid or revoked API token",
      "api_not_supported": "The server does not provide the Wallbox WEB API v1 (update Wallbox WEB, or check the URL)",
      "invalid_url": "Enter a URL starting with http:// or https://",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "Service is already configured",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful",
      "unique_id_mismatch": "This is a different Wallbox WEB server than the one configured",
      "invalid_discovery_info": "The add-on sent incomplete connection data",
      "cannot_connect": "Failed to connect",
      "invalid_auth": "The add-on token was refused",
      "api_not_supported": "The add-on does not provide the Wallbox WEB API v1",
      "unknown": "Unexpected error"
    }
  },
